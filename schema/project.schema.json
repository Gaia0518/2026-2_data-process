{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "지적원도 연결 작업 정보 (project.json)",
  "description": "편집기(app/)가 저장하고 tools/export.py가 읽는 형식. 좌표 단위는 원본 이미지 px.",
  "type": "object",
  "required": [
    "app",
    "version",
    "sheets"
  ],
  "properties": {
    "app": {
      "const": "jijeok-connect"
    },
    "version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "description": "공통 이름. 새 파일명은 <project>_<번호>"
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    },
    "layout": {
      "description": "0번 표지·배치도",
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "originalName": {
          "type": "string"
        },
        "size": {
          "$ref": "#/definitions/size"
        }
      }
    },
    "sheets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "originalName",
          "fileIndex",
          "size",
          "transform",
          "crop",
          "display"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "정리된 새 파일명"
          },
          "originalName": {
            "type": "string",
            "description": "내려받은 원래 파일명 (다시 불러올 때 대조)"
          },
          "fileIndex": {
            "type": "integer",
            "minimum": 1,
            "description": "파일 순서 번호"
          },
          "sheetNo": {
            "type": "string",
            "description": "원도에 적힌 도면 번호 (一, 十一, 11 모두 가능). 비어 있으면 파일 순서로 짝지음, '—'이면 배치에서 뺌"
          },
          "grid": {
            "type": [
              "object",
              "null"
            ],
            "description": "배치도상의 칸 위치",
            "properties": {
              "row": {
                "type": "integer"
              },
              "col": {
                "type": "integer"
              }
            }
          },
          "size": {
            "$ref": "#/definitions/size"
          },
          "z": {
            "type": "integer",
            "description": "그리는 순서 (클수록 위)"
          },
          "transform": {
            "type": "object",
            "required": [
              "x",
              "y",
              "rotation",
              "scale"
            ],
            "properties": {
              "x": {
                "type": "number",
                "description": "잘라낸 영역의 중심 x (월드 px)"
              },
              "y": {
                "type": "number",
                "description": "잘라낸 영역의 중심 y (월드 px)"
              },
              "rotation": {
                "type": "number",
                "description": "시계 방향 회전(도)"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "crop": {
            "type": "object",
            "description": "각 변에서 잘라낼 여백 (원본 px)",
            "properties": {
              "left": {
                "type": "number",
                "minimum": 0
              },
              "top": {
                "type": "number",
                "minimum": 0
              },
              "right": {
                "type": "number",
                "minimum": 0
              },
              "bottom": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "display": {
            "type": "object",
            "properties": {
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "blend": {
                "enum": [
                  "darken",
                  "multiply",
                  "normal"
                ],
                "description": "darken(어둡게, 기본) · multiply(곱하기) · normal"
              },
              "visible": {
                "type": "boolean"
              },
              "whiten": {
                "type": "boolean",
                "description": "종이 밝게: paper 밝기를 흰색으로"
              }
            }
          },
          "frame": {
            "type": [
              "object",
              "null"
            ],
            "description": "도곽(빨간 테두리) 네 모서리, 원본 px",
            "properties": {
              "corners": {
                "type": "array",
                "description": "[왼위, 오위, 오아, 왼아] 각 [x, y]",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 4,
                "maxItems": 4
              },
              "clip": {
                "type": "boolean",
                "description": "도곽 바깥 여백을 그리지 않음"
              },
              "rectify": {
                "type": "boolean",
                "description": "도곽 펴기: 네 모서리를 직사각형(가로·세로 = 마주 보는 변 길이의 평균)으로 원근 보정. 켜면 crop은 쓰지 않음"
              },
              "auto": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "자동 지정 결과 (score, review, reason)"
              }
            }
          },
          "paper": {
            "type": "number",
            "description": "종이 밝기 추정값(0~255)"
          }
        }
      }
    },
    "log": {
      "description": "Before/After 비교용 작업 기록",
      "type": "object",
      "properties": {
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "savedAt": {
          "type": "string"
        },
        "elapsedSec": {
          "type": "integer"
        },
        "ops": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "frameSize": {
      "type": [
        "object",
        "null"
      ],
      "description": "기준 도곽 크기 (월드 px). 도곽을 지정한 도면은 이 크기에 맞춰 배율이 정해지고, 자동 배열의 칸 크기가 됨",
      "properties": {
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    },
    "layoutGrid": {
      "type": [
        "object",
        "null"
      ],
      "description": "검토한 배치도 (0번 원본 px 위의 격자). cells의 no는 도엽 번호이며, 원도와는 도면 번호(없으면 파일 순서)로 짝지음",
      "properties": {
        "x0": {
          "type": "number"
        },
        "y0": {
          "type": "number"
        },
        "cw": {
          "type": "number"
        },
        "ch": {
          "type": "number"
        },
        "cols": {
          "type": "integer"
        },
        "rows": {
          "type": "integer"
        },
        "total": {
          "type": "integer",
          "description": "전체 도엽 수"
        },
        "order": {
          "enum": [
            "col-rtl",
            "col-ltr",
            "row-ltr",
            "row-rtl"
          ]
        },
        "offset": {
          "type": "object"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "row": {
                "type": "integer"
              },
              "col": {
                "type": "integer"
              },
              "no": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "size": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "[가로, 세로] 원본 px"
    }
  }
}
